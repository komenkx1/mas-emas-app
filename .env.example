# Mas Emas Environment Variables

# Self-hosted API URL (optional - defaults to production)
SELF_HOSTED_API_URL=https://api-mas-emas.mangwahyu.tech/api

# Self-hosted API Key (required for production)
SELF_HOSTED_API_KEY=your_api_key_here

# Gemini API Key (optional - fallback ke template jika kosong)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model (gunakan model yang support Google Search grounding)
AI_MODEL=gemini-2.5-flash-lite
